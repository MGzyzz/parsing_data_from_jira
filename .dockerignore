# Секреты — не должны попасть в build context, даже временно.
.env
.env.*
!.env.example
env.sh
secrets/
*client_secret*.json
*credentials*.json
*service-account*.json
*token*.json

# Локальные данные и артефакты.
cache/
data/
*.log
env-release-tracker

# Репозиторий и инструменты разработки — не нужны внутри образа.
.git/
.gitignore
docs/
*.md
