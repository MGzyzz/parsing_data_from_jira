# Сборщик: stub — локальные данные; gitlab — запуск пайплайна через API
IMAGE_COLLECTOR=stub
GITLAB_POLL_INTERVAL=3s
# Только для проекта имитации: release, release69, hotfix, mixed, empty, failed, trace
GITLAB_MOCK_SCENARIO=

# GitLab — запуск пайплайна collect-images и чтение его результатов
GITLAB_URL=https://gitlab.metadoc.kz
GITLAB_TOKEN=
COLLECT_IMAGES_PROJECT_ID=234
COLLECT_IMAGES_REF=main

# Jira — ТОЛЬКО ЧТЕНИЕ. Технический токен, не личный.
JIRA_URL=https://jira.metadoc.kz
JIRA_TOKEN=
JIRA_JQL='summary ~ "Release" AND project = DevOps'

# Правило номера релиза: Release N <-> minor = N - RELEASE_MINOR_OFFSET
RELEASE_MINOR_OFFSET=39

# Реестр сред.
# ВНИМАНИЕ: в разработке здесь только id КОПИИ таблицы.
SHEET_ID=
# Только A:I; вкладка выбирается по gid=0, первая строка — заголовок.
SHEET_RANGE=A:I
GOOGLE_CREDENTIALS_JSON=

# Какие строки реестра обрабатываем
ENV_STATUSES=active,configuring

# Кор-сервисы: только по ним считается номер релиза
CORE_SERVICES=redo-nuxeo,redo-backend,redo-camunda,redo-front,redo-integration

OVERRIDES_FILE=overrides.yaml

# Уровень логирования: debug, info, warn, error.
# debug добавляет перечень неразобранных строк Jira — нужен, когда садишься
# править сами задачи, в обычном прогоне только шумит.
LOG_LEVEL=info
CONCURRENCY=5
PIPELINE_TIMEOUT=10m
